open Lean Elab Command in
set_option maxHeartbeats 1000000 in
run_cmd do
  let env ← getEnv
  let projectPrefix := Name.mkSimple "FreudenthalSVLean"
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut audited : Nat := 0
  for (name, info) in env.constants.toList do
    if projectPrefix.isPrefixOf name then
      match info with
      | .axiomInfo _ => throwError "Project-defined axiom: {name}"
      | _ => pure ()
      let dependencies ← collectAxioms name
      for axiomName in dependencies do
        unless allowed.contains axiomName do
          throwError "Nonstandard axiom {axiomName} used by {name}"
      audited := audited + 1
  logInfo m!"Whole-project axiom audit passed: {audited} declarations; only propext, Classical.choice, Quot.sound allowed."
